{
  "$defs": {
    "CorrectionType": {
      "enum": [
        "correction",
        "clarification",
        "retraction"
      ],
      "title": "CorrectionType",
      "type": "string"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "human": {
          "const": true,
          "title": "Human",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 12,
          "title": "Reason",
          "type": "string"
        },
        "reviewedAt": {
          "format": "date-time",
          "title": "Reviewedat",
          "type": "string"
        },
        "reviewerId": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "title": "Reviewerid",
          "type": "string"
        },
        "reviewerName": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reviewername",
          "type": "string"
        },
        "reviewerRole": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reviewerrole",
          "type": "string"
        }
      },
      "required": [
        "reviewerId",
        "reviewerName",
        "reviewerRole",
        "human",
        "reviewedAt",
        "reason"
      ],
      "title": "HumanReview",
      "type": "object"
    }
  },
  "$id": "https://livewire.show/schemas/editorial/v1/correction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimId": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Claimid",
      "type": "string"
    },
    "correctedText": {
      "anyOf": [
        {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correctedtext"
    },
    "correctionId": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Correctionid",
      "type": "string"
    },
    "correctionPath": {
      "title": "Correctionpath",
      "type": "string"
    },
    "correctionType": {
      "$ref": "#/$defs/CorrectionType"
    },
    "evidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[a-z0-9][a-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Evidenceids",
      "type": "array"
    },
    "humanReview": {
      "$ref": "#/$defs/HumanReview"
    },
    "issuedAt": {
      "format": "date-time",
      "title": "Issuedat",
      "type": "string"
    },
    "objectType": {
      "const": "correction",
      "title": "Objecttype",
      "type": "string"
    },
    "priorText": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Priortext",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 12,
      "title": "Reason",
      "type": "string"
    },
    "receiptIds": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "pattern": "^[a-z0-9][a-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Receiptids",
      "type": "array"
    },
    "schemaVersion": {
      "const": "livewire.editorial.v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "storyId": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Storyid",
      "type": "string"
    },
    "supersedesCorrectionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedescorrectionid"
    }
  },
  "required": [
    "schemaVersion",
    "objectType",
    "correctionId",
    "storyId",
    "claimId",
    "receiptIds",
    "evidenceIds",
    "correctionType",
    "priorText",
    "correctedText",
    "reason",
    "issuedAt",
    "humanReview",
    "correctionPath",
    "supersedesCorrectionId"
  ],
  "title": "Correction",
  "type": "object",
  "x-livewire-schema-version": "livewire.editorial.v1"
}
