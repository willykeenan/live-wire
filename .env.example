# Copy to .env (gitignored). Every value is optional: with nothing set, Live Wire
# runs the keyless demo. Real shell environment variables win over this file.

# Opt-in live generation (LLM scripts, vendor TTS, wire/intel loops). Demo is the default.
# Setting this to 1 turns demo mode off and starts the background loops.
LIVE_WIRE_GENERATION_ENABLED=0

# Official Anthropic API (optional). If unset, Live Wire uses the `claude` CLI when present.
ANTHROPIC_API_KEY=

# ElevenLabs TTS (optional). Without it, live mode mimes speech silently.
ELEVENLABS_API_KEY=

# Optional X/Grok rumor scanning. Off by default. Never auto-confirms.
LIVE_WIRE_RUMORS_ENABLED=0

LIVE_WIRE_PORT=8899
LIVE_WIRE_NO_BROWSER=1

# Advanced (leave unset unless you need them):
# LIVE_WIRE_DEMO=1                  force canned demo even with generation on
# LIVE_WIRE_START_LOOPS=0           keep background loops off even with generation on
# LIVE_WIRE_HOST=127.0.0.1          bind address; 0.0.0.0 exposes the studio to your LAN
# LIVE_WIRE_ALLOWED_HOSTS=studio.lan  extra Host names accepted when bound beyond loopback
